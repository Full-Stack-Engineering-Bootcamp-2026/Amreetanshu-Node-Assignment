# =============================================================================
# Environment Variables Template - OrganOptima API
# =============================================================================
#
# Instructions:
# 1. Copy this file to .env in the project root
# 2. Fill in the actual values for your environment
# 3. NEVER commit .env to version control
#
# =============================================================================

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
PORT=3000

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL / AWS RDS)
# -----------------------------------------------------------------------------

# Database host
# - Local development: localhost
# - AWS RDS: your-db-instance.xxxxxxxxxxxx.region.rds.amazonaws.com
DB_HOST=localhost

# Database port (default PostgreSQL port is 5432)
DB_PORT=5432

# Database credentials
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Database name
DB_DATABASE=your-db-name

# -----------------------------------------------------------------------------
# SSL Configuration (Required for AWS RDS in production)
# -----------------------------------------------------------------------------

# Enable SSL for database connection
# - Local development: false
# - AWS RDS production: true
DB_SSL=false

# Reject unauthorized SSL certificates
# - Production: true (recommended)
# - Development with self-signed certs: false (not recommended)
DB_SSL_REJECT_UNAUTHORIZED=true

# -----------------------------------------------------------------------------
# Connection Pool Settings
# -----------------------------------------------------------------------------

# Maximum number of connections in the pool
# Adjust based on your RDS instance class and expected load
# - db.t3.micro: 10-20
# - db.t3.small: 20-40
# - db.t3.medium: 40-60
DB_POOL_MAX=20

# Minimum number of connections to maintain
DB_POOL_MIN=2

# Idle connection timeout in milliseconds (30 seconds default)
DB_IDLE_TIMEOUT=30000

# Connection acquisition timeout in milliseconds (10 seconds default)
DB_CONNECTION_TIMEOUT=10000

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------

# Enable TypeORM query logging
# - Development: true (for debugging)
# - Production: false (for performance)
DB_LOGGING=false

# -----------------------------------------------------------------------------
# JWT Configuration (if using auth module)
# -----------------------------------------------------------------------------
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=1h

