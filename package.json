{
  "name": "node-express-template",
  "version": "1.0.1",
  "description": "",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "npx tsc",
    "start": "node dist/index.js",
    "dev": "npx nodemon --exec \"ts-node\" src/index.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "swagger:generate": "ts-node src/common/utils/swagger/generate-swagger.ts",
    "swagger:dev": "npm run swagger:generate && npm run dev",
    "----------- TYPEORM MIGRATION SCRIPTS -----------": "",
    "migration:create": "npx typeorm migration:create",
    "migration:run": "npx typeorm-ts-node-commonjs migration:run -d src/db/data-source.ts",
    "migration:revert": "npx typeorm-ts-node-commonjs migration:revert -d src/db/data-source.ts",
    "migration:show": "npx typeorm-ts-node-commonjs migration:show -d src/db/data-source.ts",
    "----------- SEED DATA SCRIPTS -----------": "",
    "seed:data": "PGPASSWORD=postgres psql -h localhost -U postgres -d db-name -f src/opo-seed-data.sql",
    "----------- DO NOT USE - DISABLED -----------": "",
    "migration:generate:DISABLED": "echo 'ERROR: migration:generate is DISABLED. Write raw SQL migrations manually using migration:create' && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/swagger-ui-express": "^4.1.8",
    "argon2": "^0.44.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.22.1",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "swagger-autogen": "^2.23.7",
    "swagger-ui-express": "^5.0.1",
    "typedi": "^0.10.0",
    "typeorm": "^0.3.28",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/body-parser": "^1.19.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.11.8",
    "nodemon": "^3.1.11",
    "openapi-types": "^12.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
