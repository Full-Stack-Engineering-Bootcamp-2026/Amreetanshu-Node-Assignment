<!DOCTYPE html>
<html>
<head>
  <title>Add Product</title>
</head>
<body>
  <h1>Add Product</h1>

  <form action="/admin/add-product" method="POST">
  <input type="text" name="title" placeholder="Title">
  <input type="text" name="price" placeholder="Price">
  <input type="text" name="description" placeholder="Description">
  <button type="submit">Add</button>
</form>

<form action="<%= editing ? '/admin/edit-product' : '/admin/add-product' %>" method="POST">

  <input type="text" name="title" value="<%= editing ? product.title : '' %>">

  <input type="text" name="price" value="<%= editing ? product.price : '' %>">

  <input type="text" name="description" value="<%= editing ? product.description : '' %>">

  <% if (editing) { %>
    <input type="hidden" name="productId" value="<%= product.id %>">
  <% } %>

  <button type="submit">Save</button>
</form>
</body>
</html>